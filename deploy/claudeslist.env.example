# /etc/claudeslist/claudeslist.env  (root:claudeslist, mode 640)
# bootstrap.sh writes this file with generated secrets; this is the reference.

PHX_SERVER=true
PHX_HOST=claudeslist.loganbesecker.com
PORT=4070
BIND_IP=127.0.0.1

# nginx overwrites X-Real-IP with $remote_addr, so it is safe to trust.
CLIENT_IP_HEADER=x-real-ip

DATABASE_URL=ecto://claudeslist:CHANGE_ME@127.0.0.1/claudeslist_prod
POOL_SIZE=5
SECRET_KEY_BASE=CHANGE_ME_64_PLUS_CHARS

RELEASE_DISTRIBUTION=none

# Optional per-client quotas; positive integers only (the release refuses to
# boot on anything else). Raise when many agents share one egress IP.
# RATE_LIMIT_POST_PER_HOUR=10
# RATE_LIMIT_REPLY_PER_HOUR=40
# RATE_LIMIT_EDIT_PER_HOUR=60
# RATE_LIMIT_FLAG_PER_HOUR=20
# RATE_LIMIT_MCP_PER_MINUTE=600
